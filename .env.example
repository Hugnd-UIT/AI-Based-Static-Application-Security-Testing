# OpenAI-compatible endpoint used by every LLM agent.
AI_BASE_URL=https://ai-based-static-application-security.onrender.com/v1

# Model API key. Separate multiple keys with commas to rotate between them.
AI_API_KEY=YOUR AI API KEY

# Optional keys that enrich CVE findings during dependency analysis.
# Without them the scan still runs, but with less CVE context.
FIRECRAWL_API_KEY=YOUR FIRECRAWL API KEY
GITHUB_API_KEY=YOUR GITHUB TOKEN
NIST_API_KEY=YOUR NVD API KEY
